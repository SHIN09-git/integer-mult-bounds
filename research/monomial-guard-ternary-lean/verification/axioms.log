@Ternary.envelope : ∀ {I : Type u_1} {D : Type u_2} [inst : DecidableEq I] [inst_1 : Fintype I] [inst_2 : Fintype D]
  (s : HZ.State I Ternary.F (D → Ternary.F)),
  ∑ i, s.charge i = 0 →
    ∑ i, Ternary.scalar s i = 1 →
      max (Ternary.S s) (Ternary.L s) ≤ Ternary.C s ∧ Ternary.C s ≤ 2 * Ternary.S s + Ternary.L s
@Ternary.fullguard_iff : ∀ {I : Type u_1} {D : Type u_2} [DecidableEq I] [inst : Fintype I] [inst_1 : Fintype D]
  (s : HZ.State I Ternary.F (D → Ternary.F)),
  ∑ i, s.charge i = 0 →
    ∑ i, Ternary.scalar s i = 1 →
      (Ternary.FullGuard s ↔ HZ.Separated s ∧ (Ternary.imbalance s = 1 ∨ Ternary.imbalance s = -2))
@Ternary.fullguard_run_iff : ∀ {D : Type u_1} [inst : Fintype D] {m n : ℕ}
  (s : HZ.State (Fin m) Ternary.F (D → Ternary.F)),
  (∃ t, HZ.Run s n t ∧ Ternary.FullGuard t) ↔ ∃ t, HZ.Run s n t ∧ HZ.Passes t
@Ternary.guard_lower_bound : ∀ {I : Type u_1} {D : Type u_2} [inst : DecidableEq I] [inst_1 : Fintype I]
  [inst_2 : Fintype D] {s t : HZ.State I Ternary.F (D → Ternary.F)} {n : ℕ},
  ∑ i, s.charge i = 0 →
    ∑ i, Ternary.scalar s i = 1 → HZ.Run s n t → Ternary.FullGuard t → max (Ternary.S s) (Ternary.L s) ≤ n
@Ternary.guard_upper_attained : ∀ {I : Type u_1} {D : Type u_2} [inst : DecidableEq I] [inst_1 : Fintype I]
  [inst_2 : Fintype D] (s : HZ.State I Ternary.F (D → Ternary.F)),
  ∑ i, s.charge i = 0 →
    ∑ i, Ternary.scalar s i = 1 → ∃ n t, HZ.Run s n t ∧ Ternary.FullGuard t ∧ n ≤ 2 * Ternary.S s + Ternary.L s
@Ternary.strong_guard_bound : ∀ {I : Type u_1} [inst : DecidableEq I] [inst_1 : Fintype I] {D : Type u_2}
  [inst_2 : Fintype D] {s t : HZ.State I Ternary.F (D → Ternary.F)} {n : ℕ},
  (∀ (i : I), s.w i = 0 → Ternary.scalar s i = 1) →
    ∑ i, s.charge i = 0 →
      ∑ i, Ternary.scalar s i = 1 → HZ.Run s n t → Ternary.FullGuard t → Ternary.weightSum s ≤ 3 * ↑n + 1
Ternary.sharp_endpoints : ∀ (r n : ℕ),
  (Ternary.S (Ternary.lower r n) = r ∧ Ternary.L (Ternary.lower r n) = n ∧ Ternary.C (Ternary.lower r n) = max r n) ∧
    Ternary.S (Ternary.upper r n) = r ∧ Ternary.L (Ternary.upper r n) = n ∧ Ternary.C (Ternary.upper r n) = 2 * r + n
Ternary.lower_attained : ∀ (r n : ℕ), ∃ t, HZ.Run (Ternary.lower r n) (max r n) t ∧ Ternary.FullGuard t
Ternary.upper_attained : ∀ (r n : ℕ), ∃ t, HZ.Run (Ternary.upper r n) (2 * r + n) t ∧ Ternary.FullGuard t
Ternary.upper_word_lower_bound : ∀ (r n k : ℕ) (t : Ternary.Pencil (Ternary.Coord (Fin r) (2 * r + 3 * n + 1))),
  HZ.Run (Ternary.upper r n) k t → Ternary.FullGuard t → 2 * r + n ≤ k
Ternary.endpoint_nonzero_slopes : ∀ (r n : ℕ),
  (∃ i, (Ternary.lower r n).w i () ≠ 0) ∧ ∃ i, (Ternary.upper r n).w i () ≠ 0
